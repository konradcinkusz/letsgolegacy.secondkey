<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The artifact formats that are Second Key's product interface: capture, contract, run, verdict.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schemas in /schemas are the source of truth; the library embeds them rather than copying them. -->
    <EmbeddedResource Include="..\..\schemas\*.schema.json" LogicalName="schemas/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecondKey.Artifacts.Tests" />
  </ItemGroup>

</Project>
