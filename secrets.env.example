# Every variable sk or a local script may read, by tier (REPO-BASELINE.md §2).
# Copy to .env (gitignored) and fill in. Never commit real values.
#
# Nothing loads .env for you: sk and the scripts read the process environment only. Export
# what you filled in before running them, for example in bash:
#     set -a; . ./.env; set +a
# A variable that is empty or missing is "not set"; sk replay then stops by name (exit 3).
#
# Optional — only for replaying against a SQL Server with snapshot reset (S11):
#   SK_LEGACY_DB     connection string of the legacy side's database
#   SK_CANDIDATE_DB  connection string of the candidate side's database
SK_LEGACY_DB=
SK_CANDIDATE_DB=
#
# Optional — only for PDF rendering of the evidence pack when Chromium is not on PATH:
#   SK_CHROME_PATH   absolute path of a Chromium/Chrome executable
SK_CHROME_PATH=
