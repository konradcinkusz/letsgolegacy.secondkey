# Every variable a local script may read, by tier (REPO-BASELINE.md §2).
# Copy to .env (gitignored) and fill in. Never commit real values.
#
# Optional — only for replaying against a SQL Server with snapshot reset (S11):
#   SK_LEGACY_DB     connection string of the legacy side's database
#   SK_CANDIDATE_DB  connection string of the candidate side's database
SK_LEGACY_DB=
SK_CANDIDATE_DB=
#
# Optional — only for PDF rendering of the evidence pack when Chromium is not on PATH:
#   SK_CHROME_PATH   absolute path of a Chromium/Chrome executable
SK_CHROME_PATH=
