{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konradcinkusz/letsgolegacy.secondkey/schemas/skcap.schema.json",
  "title": "Second Key capture event",
  "description": "One line of a *.skcap file (JSON Lines). The first line of a file is a capture.header; every later line is an event. Events of one request are correlated by the exchange id. Version 1 carries HTTP exchanges only; SQL statements, queue messages and outbound calls arrive in later versions as new event types.",
  "type": "object",
  "required": ["type", "v"],
  "oneOf": [
    { "$ref": "#/$defs/header" },
    { "$ref": "#/$defs/httpExchange" }
  ],
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "v", "captureId", "startedAt", "tool", "source"],
      "properties": {
        "type": { "const": "capture.header" },
        "v": { "const": 1 },
        "captureId": { "$ref": "#/$defs/id" },
        "startedAt": { "type": "string", "format": "date-time" },
        "tool": { "$ref": "#/$defs/tool" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["http-proxy", "synthetic"] },
            "target": { "type": "string", "format": "uri" },
            "listen": { "type": "string" }
          }
        },
        "sanitization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redactedHeaders": { "type": "array", "items": { "$ref": "#/$defs/headerName" }, "uniqueItems": true },
            "maxBodyBytes": { "type": "integer", "minimum": 0 }
          }
        },
        "sessionKeys": {
          "description": "Cookie or header names whose value identifies a user session; the exchanges of one session replay as one scenario.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "httpExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "v", "id", "seq", "session", "startedAt", "durationMs", "request", "response"],
      "properties": {
        "type": { "const": "http.exchange" },
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "seq": { "type": "integer", "minimum": 1 },
        "session": { "type": "string", "minLength": 1, "maxLength": 128 },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "request": { "$ref": "#/$defs/request" },
        "response": { "$ref": "#/$defs/response" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "headers"],
      "properties": {
        "method": { "type": "string", "pattern": "^[A-Z]{3,10}$" },
        "path": { "type": "string", "pattern": "^/" },
        "query": { "type": "string", "pattern": "^\\?" },
        "headers": { "$ref": "#/$defs/headers" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "headers"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": { "$ref": "#/$defs/headers" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "headers": {
      "description": "Header names in lower case; every value is an array because HTTP allows a header to repeat. A redacted value is the literal string <redacted>.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/headerName" },
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "headerName": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" },
    "body": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "json"],
          "properties": {
            "encoding": { "const": "json" },
            "json": true,
            "contentType": { "type": "string" },
            "size": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "text"],
          "properties": {
            "encoding": { "const": "text" },
            "text": { "type": "string" },
            "contentType": { "type": "string" },
            "size": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "base64"],
          "properties": {
            "encoding": { "const": "base64" },
            "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
            "contentType": { "type": "string" },
            "size": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" }
          }
        }
      ]
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": ["string", "null"] }
      }
    }
  }
}
