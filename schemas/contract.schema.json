{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konradcinkusz/letsgolegacy.secondkey/schemas/contract.schema.json",
  "title": "Second Key contract",
  "description": "contract.yaml — what the system must do and what it must never do, plus the rules that say which differences between two versions do not matter. Written in YAML, validated as JSON. Strict: an unknown key is an error, never ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "clauses"],
  "properties": {
    "apiVersion": { "const": "secondkey/v1" },
    "kind": { "const": "Contract" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "title": { "type": "string" },
        "system": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "owners": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compare": {
      "description": "What the comparator looks at besides the status code and the body.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headers": {
          "description": "Response headers compared between the two versions. Default: content-type and location.",
          "type": "array",
          "items": { "$ref": "#/$defs/headerName" },
          "uniqueItems": true
        },
        "html": {
          "description": "extracts: an HTML body is compared only through the values the extractors pull out of it (markup is not behaviour). text: compared as text.",
          "enum": ["extracts", "text"]
        }
      }
    },
    "extract": {
      "type": "array",
      "items": { "$ref": "#/$defs/extractor" }
    },
    "normalize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
        "tolerances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "absolute": { "type": "number", "exclusiveMinimum": 0 },
              "relative": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            },
            "oneOf": [
              { "required": ["absolute"], "not": { "required": ["relative"] } },
              { "required": ["relative"], "not": { "required": ["absolute"] } }
            ]
          }
        },
        "sets": {
          "description": "Arrays compared as unordered collections. With a key, elements are matched by that key; without one, by their whole value.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "key": {
                "description": "A path relative to each element, e.g. sku or id.value.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_$-]+([.\\[].*)?$"
              }
            }
          }
        },
        "masks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timestamps": { "type": "boolean" },
            "guids": { "type": "boolean" },
            "patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "regex", "replacement"],
                "properties": {
                  "name": { "$ref": "#/$defs/name" },
                  "regex": { "type": "string", "minLength": 1 },
                  "replacement": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clause" }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_-]{0,63}$" },
    "clauseId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$", "maxLength": 64 },
    "headerName": { "type": "string", "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" },
    "path": {
      "description": "A selector over an observation: request, response, extract, db, outbound. Dotted segments; [n] index; [*] every element; ** any depth; [\"quoted.name\"] for names with dots.",
      "type": "string",
      "pattern": "^(request|response|extract|db|outbound)([.\\[].*)?$"
    },
    "match": {
      "description": "Which requests a clause or an extractor applies to. Every key given must match.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "method": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Z]{3,10}$" },
            { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3,10}$" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "path": { "description": "A regular expression matched against the request path.", "type": "string", "minLength": 1 },
        "query": {
          "description": "Query parameter name → regular expression its value must match.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "selector"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "when": { "$ref": "#/$defs/match" },
        "from": { "enum": ["html", "json", "header", "text"] },
        "selector": {
          "description": "html: a CSS selector. json: a path inside the JSON body (e.g. items[0].price). header: a header name. text: a regular expression whose first group is the value.",
          "type": "string",
          "minLength": 1
        },
        "attribute": { "description": "html only: read this attribute instead of the element's text.", "type": "string", "minLength": 1 },
        "regex": { "description": "Applied to the selected text; the first capture group is the value.", "type": "string", "minLength": 1 },
        "as": { "enum": ["string", "decimal", "integer", "boolean"] },
        "culture": { "description": "Culture used to parse numbers, e.g. en-US or pl-PL. Default: invariant.", "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "all": { "description": "Extract every match as an array instead of the first one.", "type": "boolean" }
      },
      "allOf": [
        { "if": { "required": ["attribute"] }, "then": { "properties": { "from": { "const": "html" } } } }
      ]
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "why", "assert", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/clauseId" },
        "kind": {
          "description": "must: every assertion holds for every request in scope. never: the assertions never all hold together for any request in scope.",
          "enum": ["must", "never"]
        },
        "title": { "type": "string", "minLength": 3 },
        "why": { "description": "What breaks for the business if this clause stops holding. A clause that cannot answer this is decoration.", "type": "string", "minLength": 10 },
        "when": { "$ref": "#/$defs/match" },
        "assert": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/predicate" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "status"],
      "properties": {
        "origin": { "enum": ["designed", "mined", "llm-draft", "incident", "review", "production-trace", "manual-session"] },
        "status": {
          "description": "Only accepted clauses count towards a verdict; proposed ones are reported and decide nothing.",
          "enum": ["proposed", "accepted"]
        },
        "author": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "support": {
          "description": "For mined clauses: how many observations the invariant was seen on, and how many contradicted it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["observations", "violations"],
          "properties": {
            "observations": { "type": "integer", "minimum": 0 },
            "violations": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select", "op"],
      "properties": {
        "select": { "$ref": "#/$defs/path" },
        "op": {
          "enum": [
            "exists", "absent",
            "equals", "notEquals",
            "lt", "lte", "gt", "gte", "between", "approx",
            "matches", "notMatches", "contains", "notContains",
            "in", "notIn",
            "countEquals", "countAtLeast", "countAtMost"
          ]
        },
        "value": true,
        "ref": { "$ref": "#/$defs/path" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "absolute": { "type": "number", "exclusiveMinimum": 0 },
        "relative": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "quantifier": {
          "description": "For a selection with several values. all (default): at least one value, and every value satisfies. any: at least one value satisfies. none: no value satisfies (an empty selection qualifies).",
          "enum": ["all", "any", "none"]
        },
        "ignoreCase": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["exists", "absent"] } } },
          "then": {
            "properties": {
              "value": false, "ref": false, "min": false, "max": false,
              "absolute": false, "relative": false, "quantifier": false, "ignoreCase": false
            }
          }
        },
        {
          "if": { "properties": { "op": { "enum": ["equals", "notEquals", "lt", "lte", "gt", "gte", "contains", "notContains"] } } },
          "then": {
            "oneOf": [
              { "required": ["value"], "not": { "required": ["ref"] } },
              { "required": ["ref"], "not": { "required": ["value"] } }
            ],
            "properties": { "min": false, "max": false, "absolute": false, "relative": false }
          }
        },
        {
          "if": { "properties": { "op": { "const": "between" } } },
          "then": {
            "required": ["min", "max"],
            "properties": { "value": false, "ref": false, "absolute": false, "relative": false, "ignoreCase": false }
          }
        },
        {
          "if": { "properties": { "op": { "const": "approx" } } },
          "then": {
            "allOf": [
              {
                "oneOf": [
                  { "required": ["value"], "not": { "required": ["ref"] } },
                  { "required": ["ref"], "not": { "required": ["value"] } }
                ]
              },
              {
                "oneOf": [
                  { "required": ["absolute"], "not": { "required": ["relative"] } },
                  { "required": ["relative"], "not": { "required": ["absolute"] } }
                ]
              }
            ],
            "properties": { "min": false, "max": false, "ignoreCase": false }
          }
        },
        {
          "if": { "properties": { "op": { "enum": ["matches", "notMatches"] } } },
          "then": {
            "required": ["value"],
            "properties": { "value": { "type": "string", "minLength": 1 }, "ref": false, "min": false, "max": false, "absolute": false, "relative": false }
          }
        },
        {
          "if": { "properties": { "op": { "enum": ["in", "notIn"] } } },
          "then": {
            "required": ["value"],
            "properties": { "value": { "type": "array", "minItems": 1 }, "ref": false, "min": false, "max": false, "absolute": false, "relative": false }
          }
        },
        {
          "if": { "properties": { "op": { "enum": ["countEquals", "countAtLeast", "countAtMost"] } } },
          "then": {
            "required": ["value"],
            "properties": {
              "value": { "type": "integer", "minimum": 0 },
              "ref": false, "min": false, "max": false, "absolute": false, "relative": false, "quantifier": false, "ignoreCase": false
            }
          }
        },
        {
          "if": { "properties": { "op": { "enum": ["lt", "lte", "gt", "gte", "between", "approx"] } } },
          "then": { "properties": { "ignoreCase": false } }
        }
      ]
    }
  }
}
