# Build output
bin/
obj/
out/
artifacts/
publish/

# IDE and OS
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo
*.swp
.DS_Store
Thumbs.db

# Test and mutation output
TestResults/
coverage/
*.coverage
*.coveragexml
StrykerOutput/

# Local secrets (P5): only the committed example file is tracked
.env
.env.*
!.env.example
secrets.env
!secrets.env.example

# Second Key run output (recordings may contain customer data; never commit real ones)
*.skcap
*.skrun
!samples/**/*.skcap
!samples/**/*.skrun
!schemas/samples/**
!tests/**/fixtures/**
.secondkey/
evidence-out/

# Documentation build output — nothing generated is committed, and each pattern names the
# build it belongs to (architecture-standards, docs/research/00-RESEARCH-DOCUMENTATION.md,
# "What a .gitignore for LaTeX actually has to cover"). latexmk's three files are here
# because the CI build drives latexmk.
node_modules/
docs/papers/*.pdf
docs/papers/*.aux
docs/papers/*.log
docs/papers/*.out
docs/papers/*.toc
docs/papers/*.fdb_latexmk
docs/papers/*.fls
docs/papers/*.synctex.gz
docs/papers/version.tex
docs/diagrams/rendered/
