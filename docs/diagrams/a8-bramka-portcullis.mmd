flowchart TB
  PR["pull request kandydata"] --> SCAN["portcullis scan<br/>--provenance-range base..head"]
  SCAN --> RES["wynik JSON<br/>summary: wszystko znalezione"]
  SCAN -- "--sarif" --> SARIF[("SARIF 2.1.0")]
  RES --> G["błąd na linii zmienionej w PR<br/>(ostrzeżenie na linii AI = błąd,<br/>przy awarii git: błąd w całym skanie),<br/>nie w baseline?"]
  G -- tak --> BLK["gate.blocked = true<br/>exit 1"]
  G -- nie --> OK["exit 0"]
  SARIF --> SKG["sk gate<br/>(podsumowanie per reguła)"]
  SKG --> PACK["pakiet dowodowy"]
  classDef q fill:#FEF5E7,stroke:#E67E22,color:#1F4E79
  classDef bad fill:#FDEDEC,stroke:#C0392B,color:#78281F
  classDef good fill:#E9F7EF,stroke:#27AE60,color:#145A32
  class G q
  class BLK bad
  class OK good
