    "primaryTextColor": "#1F4E79",
    "secondaryColor": "#ECF0F1",
    "tertiaryColor": "#FFFFFF",
    "lineColor": "#34495E",
    "clusterBkg": "#F8FAFB",
    "clusterBorder": "#95A5A6",
    "actorBkg": "#EAF2F8",
